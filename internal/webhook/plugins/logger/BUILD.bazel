load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "logger",
    srcs = ["logger.go"],
    importpath = "github.com/ChronicCmposer/gitd/internal/webhook/plugins/logger",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/event",
        "//internal/webhook",
    ],
)

go_test(
    name = "logger_test",
    srcs = ["logger_test.go"],
    embed = [":logger"],
    deps = [
        "//internal/config",
        "//internal/event",
        "//internal/webhook",
    ],
)
