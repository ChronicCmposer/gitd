load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webhook",
    srcs = [
        "deliverer.go",
        "policy.go",
        "registry.go",
        "webhook.go",
    ],
    importpath = "github.com/ChronicCmposer/gitd/internal/webhook",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/event",
        "//internal/gitenv",
        "//internal/spool",
    ],
)

go_test(
    name = "webhook_test",
    srcs = [
        "deliverer_test.go",
        "policy_test.go",
    ],
    embed = [":webhook"],
    deps = [
        "//internal/config",
        "//internal/event",
        "//internal/spool",
    ],
)
