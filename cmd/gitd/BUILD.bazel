load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gitd_lib",
    srcs = ["main.go"],
    importpath = "github.com/ChronicCmposer/gitd/cmd/gitd",
    visibility = ["//visibility:private"],
    deps = ["//internal/cli"],
)

# Link-time version stamping (R1-Q11/Q14): rules_go substitutes {STABLE_VERSION}
# (from workspace-status.sh, enabled by build --stamp in .bazelrc) into the
# binary at link time via x_defs, overriding the v0.0.0-devel initializer. No
# generated code — the version lives only in the tag + this link-time
# substitution.
go_binary(
    name = "gitd",
    embed = [":gitd_lib"],
    x_defs = {
        "github.com/ChronicCmposer/gitd/internal/version.Version": "{STABLE_VERSION}",
    },
    visibility = ["//visibility:public"],
)

# Static variant for the from-scratch image (//image:image): the image has no
# dynamic loader, so the gateway binary must be fully static. Built separately
# from the dev binary so the two can use different link modes.
go_binary(
    name = "gitd_static",
    embed = [":gitd_lib"],
    pure = "on",
    static = "on",
    x_defs = {
        "github.com/ChronicCmposer/gitd/internal/version.Version": "{STABLE_VERSION}",
    },
    visibility = ["//visibility:public"],
)
