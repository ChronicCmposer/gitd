load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gitd_lib",
    srcs = ["main.go"],
    importpath = "github.com/ChronicCmposer/gitd/cmd/gitd",
    visibility = ["//visibility:private"],
    deps = ["//internal/cli"],
)

go_binary(
    name = "gitd",
    embed = [":gitd_lib"],
    visibility = ["//visibility:public"],
)
