"""gitd — personal git server on AWS.

Bazel module definition (bzlmod). Toolchain pins follow the strimserver-proven
combo: rules_go 0.63.0 + gazelle 0.54.0. External dist artifacts (openssh,
git, fish, sudo, ca-certificates, containerd, runc) are declared as
checksummed repo rules via //:dist.bzl with pins generated by
tools/dist/gen-dist-pins.sh into //:dist_pins.bzl. The from-scratch OCI image
(rules_oci, //image:image) assembles those tarballs with the in-image files.
"""

module(
    name = "gitd",
    version = "0.0.0",
)

# Bazel toolchains. rules_go + gazelle combo proven by strimserver.
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")

# The gazelle binary (bazel run @bazel_gazelle//:gazelle) links the skylib
# BZL language from this plugin repo.
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.7.1")

# Go toolchain. rules_go's go_sdk.from_file reads the go.mod "go" directive,
# which for us is the language-version floor "1.26" (not a downloadable SDK
# version), so pin the concrete SDK explicitly. Keep this aligned with the
# dev toolchain in tools/dist/versions.sh (GO_VERSION, build-pinned-go.sh).
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.5",
)
use_repo(go_sdk, "go_sdk")

# Go module dependencies. go_deps reads go.mod/go.sum, so the single source of
# truth for Go deps is go.mod. The mutesting pin (jonbaldie/go-mutesting/v2
# v2.7.9, R4-Q1) lives in go.mod from Phase 1; the rules_go-built mutation
# binary (//tools/mutesting, see tools/mutesting/BUILD.bazel) consumes it here
# in Phase 9. go_deps generates BUILD files for every fetched module, so the
# canonical cmd/go-mutesting binary target resolves automatically.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_alecthomas_chroma_v2", "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_service_s3", "com_github_jonbaldie_go_mutesting_v2", "com_github_yuin_goldmark", "com_github_yuin_goldmark_highlighting_v2", "in_gopkg_yaml_v3")

# OCI image assembly (2.5). rules_oci 2.3.0 pulls its own toolchain deps
# (crane/regctl/jq via aspect_bazel_lib, bsd tar). rules_pkg provides
# pkg_tar for the in-image layers; bazel_features is an explicit dep of the
# rules_oci toolchain selection.
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_features", version = "1.51.0")

# Pinned distribution artifacts (@openssh_dist, @git_dist, @fish_dist,
# @sudo_dist, @ca_certs_dist, @containerd_dist, @runc_dist). Pins live in
# //:dist_pins.bzl; repo rules are lazy, so nothing fetches until a target
# (currently only //image:image, tags=["manual"]) actually depends on them.
dist = use_extension("//:dist.bzl", "dist")
use_repo(
    dist,
    "ca_certs_dist",
    "containerd_dist",
    "fish_dist",
    "git_dist",
    "openssh_dist",
    "runc_dist",
    "sudo_dist",
)
