# gitd scoped sudoers (baked at build time, R8-Q1).
#
# The image rootfs is --rootfs-ro, so sudoers cannot be provisioned at
# runtime; this file IS the policy. Admin elevation is restricted to exactly
# the gitd data-plane verbs run as the git user (R4-Q11), NOPASSWD. Nothing
# else is permitted, and no other users may sudo.
#
# The command list is deliberately exact (no wildcards beyond a single
# argument for the id/repo operands):
#   gitd spool list
#   gitd spool replay <id>
#   gitd spool purge
#   gitd mirror list <repo>
#   gitd mirror delete <repo>

Defaults env_reset
Defaults secure_path = /usr/local/bin

root ALL=(ALL) ALL
admin ALL=(git) NOPASSWD: /usr/local/bin/gitd spool list, \
        /usr/local/bin/gitd spool replay *, \
        /usr/local/bin/gitd spool purge, \
        /usr/local/bin/gitd mirror list *, \
        /usr/local/bin/gitd mirror delete *